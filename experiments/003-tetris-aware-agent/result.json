  "clear_size_metric": {
    "compatibility": "a record that carries neither the per-episode field nor the summary section is older and still verifies; a present section is compared with the same type-and-key rules as the mandatory ones; and presence is all-or-nothing per agent and must agree between the episodes and the summary, so a summary that omitted the totals its episodes record, or an agent with some episodes histogrammed and some not, is rejected rather than verified without them",
    "definitions": {
      "headline_tetris_line_rate": "4 * tetrises / total lines; zero total lines is a rate of 0.0",
      "safety_cap": "an episode stopped at the configured frame_limit is a configured safety stop, never a game over",
      "tetrises_per_100_placed_pieces": "100 * tetrises / pieces_placed"
    },
    "field": "clear_sizes",
    "fields": [
      "singles",
      "doubles",
      "triples",
      "tetrises"
    ],
    "live_path": "live desktop play builds its own episode and suite record, so it tallies and records the same histogram before saving; without it a live game that cleared a line would save a record whose summary did not match its episode and would fail verification",
    "place": "an optional top-level per-episode field beside pieces_placed, never a leaf inside result or result.event_counts, because verify_run compares a result object's keys with the replay's exactly",
    "source": "the engine's own per-step events.lines_cleared (1/2/3/4), the same event result.event_counts.lines_cleared sums, so the histogram adds up to result.lines",
    "summary": "each agent's summary carries the totals of its episodes' histograms"
  },
